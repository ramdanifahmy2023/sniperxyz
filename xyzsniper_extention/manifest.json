{
  "manifest_version": 3,
  "name": "XYZ Sniper",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "Rekam request, aktivitas, dan angka halaman untuk audit melalui Sniper dan MCP.",
  "icons": {
    "16": "assets/images/icon_16.png",
    "32": "assets/images/icon_32.png",
    "48": "assets/images/icon_48.png",
    "128": "assets/images/icon_128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/images/icon_16.png",
      "32": "assets/images/icon_32.png",
      "48": "assets/images/icon_48.png",
      "128": "assets/images/icon_128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/js/privacy.js", "assets/js/page-snapshot.js", "assets/js/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["assets/js/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "assets/js/background.js"
  }
}
