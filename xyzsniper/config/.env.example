# Application Info
APP_NAME="XYZ Snipper"
APP_MODE="local"
APP_URL_LOCAL="http://localhost:8000"
APP_URL_HOST="https://your-domain.example"

# Routing Configuration
DEFAULT_CONTROLLER="Auth"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Database Configuration
DB_HOST_LOCAL="127.0.0.1"
DB_PORT_LOCAL="3308"
DB_USER_LOCAL="root"
DB_PASS_LOCAL=""
DB_NAME_LOCAL="xyzsniper_db"

DB_HOST_HOST="127.0.0.1"
DB_PORT_HOST="3306"
DB_USER_HOST="your-database-user"
DB_PASS_HOST="your-database-password"
DB_NAME_HOST="xyzsniper_db"
